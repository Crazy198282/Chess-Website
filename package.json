{
  "name": "chess-website",
  "version": "1.0.0",
  "description": "A chess platform with Glicko-2 rating system, Stockfish analysis, and real-time multiplayer",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "NODE_ENV=development nodemon --exec ts-node src/server/index.ts",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "cd client && npm run build",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "postgres": "^3.3.4",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "chess.js": "^1.0.0-beta.8",
    "dotenv": "^16.0.3",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^18.11.18",
    "typescript": "^4.9.4",
    "ts-node": "^10.9.1",
    "nodemon": "^2.0.20",
    "concurrently": "^7.6.0"
  }
}
